# ---- Agent Server ----
PORT=3000
LOG_LEVEL=info

# ---- LLM Provider ----
# deepseek = DeepSeek 官方 API（唯一推理后端，deepseek-v4-flash）
# dashscope = 千问 OpenAI 兼容接口（备用选项）
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_LLM_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 语音总开关：实时语音已废弃（桌面端下线、微信语音走 iLink 服务端转写），
# 保持 false 禁用路由注册——三个 /ws/voice WebSocket 路由（legacy/cascade/s2s）
# 与 @fastify/websocket 升级钩子都不上挂，只保留文字聊天。
# 注意：config 里的默认值仍是 true（未设置该变量即为开启），因此生产环境必须
# 在 .env 里显式写 VOICE_ENABLED=false，不能靠省略。
VOICE_ENABLED=false
# 语音输出开关：仅在 VOICE_ENABLED=true 时有意义——false 时 ASR（识别你的语音）
# 仍可用，但回复只出文字不发声
VOICE_TTS_ENABLED=true
# 全权限模式：true 时所有工具（含 L2/L3：终端/电源/删除等）自动执行，不弹确认
AUTO_APPROVE_ALL=false
# 备用 LLM 后端（OpenCrabs 故障转移思路）：none = 关闭（仅 DeepSeek 官方）
# openrouter / dashscope 已停用；保留字段仅作兼容
LLM_FALLBACK_PROVIDER=none
LLM_FALLBACK_MODEL=deepseek/deepseek-v4-flash

# ---- ElevenLabs ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_LANGUAGE=zh

# ---- Qwen Realtime Voice (百炼) ----
# s2s = 端到端 Qwen 实时语音（低延迟，推理用 Qwen）；cascade = Qwen ASR -> LLM -> ElevenLabs TTS
QWEN_VOICE_MODE=s2s
DASHSCOPE_API_KEY=
# 文字推理模型（LLM_PROVIDER=dashscope 时生效）
DASHSCOPE_LLM_MODEL=qwen3.8-max
# 长期记忆语义检索用的嵌入模型（百炼 text-embedding-v4，1024 维）
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_REALTIME_MODEL=qwen-audio-3.0-realtime-plus
QWEN_REALTIME_VOICE=longanqian
QWEN_ASR_MODEL=qwen3-asr-flash-realtime
QWEN_REALTIME_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime

# ---- PostgreSQL ----
DATABASE_URL=postgres://assistant:assistant@localhost:5432/assistant

# ---- coding.run 后端 ----
# 唯一后端 dsh = DeepSeek Harness，headless 一次性会话，插件化可扩展
# dsh 后端使用的 DeepSeek 官方 API Key（服务器部署时必填）
DEEPSEEK_API_KEY=
# 可选：dsh 的 bin.js 绝对路径（默认 %APPDATA%\npm\node_modules\@deepseek-ai\dsh\lib\bin.js）
DSH_CLI=
# 小美专用 OpenAI 路由（只影响 designer.delegate，不影响小夜主链路）
OPENAI_API_KEY=
XIAOMEI_OPENAI_MODEL=gpt-4.1
XIAOMEI_DSH_PATCH=/app/infrastructure/dsh/xiaomei-openai.patch.yml

# ---- 微信 ClawBot 桥（weixin-bridge）----
# weixin-bridge 调用 agent-server 的地址（compose 内为 http://app:3000）
AGENT_URL=http://127.0.0.1:3000
# agent-server 回调微信桥的地址（compose 内为 http://weixin-bridge:3100）
WEIXIN_BRIDGE_URL=http://127.0.0.1:3100
WEIXIN_PORT=3100
# 微信收图理解用的视觉模型（DeepSeek 官方 API，默认 deepseek-v4-flash-vision-exp；
# 需要 DEEPSEEK_API_KEY；DASHSCOPE_API_KEY 仅对 DashScope 端点有效，不能用于 DeepSeek 端点）
WEIXIN_VISION_MODEL=deepseek-v4-flash-vision-exp
# 视觉模型 OpenAI 兼容 chat/completions 端点（默认 DeepSeek 官方）
WEIXIN_VISION_ENDPOINT=https://api.deepseek.com/chat/completions
# 微信文件库目录（compose 内 /data/weixin-files，宿主机 <仓库>/weixin-files）
WEIXIN_FILES_DIR=/data/weixin-files

# ---- Home Assistant（后续阶段） ----
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# ---- 腾讯云轻量服务器（Lighthouse）云管理 ----
# 供 cloud.instance_status / cloud.firewall_list / cloud.firewall_open /
# cloud.firewall_close 使用；不配置则 cloud.* 工具不注册。
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# 实例所在地域（默认 ap-shanghai）
TENCENT_REGION=ap-shanghai
# 轻量应用服务器实例 ID（默认 lhins-f1k9cz9m）
TENCENT_LIGHTHOUSE_INSTANCE_ID=lhins-f1k9cz9m
