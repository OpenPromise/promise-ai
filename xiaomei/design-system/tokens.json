{
  "$schema": "https://json.schemastore.org/design-tokens",
  "name": "xiaohei-team-design-system",
  "version": "0.1.0",
  "description": "团队 Design System 初始 tokens（小美维护）。颜色初始值复用官网 style-guide 色板（team-site/docs/style-guide.md：#1d1d1d 深底系 + #50e5fb 青色主强调），浅色界面为小美主页风格（留白/黑白灰 + 品牌点缀）。语义 token 全项目统一，扩展流程见 README.md。",
  "colors": {
    "bg": { "value": "#fafafa", "description": "浅色界面主底（留白/画廊感）" },
    "bg-dark": { "value": "#1d1d1d", "description": "深色界面主底（对齐官网 style-guide）" },
    "bg-deep": { "value": "#161616", "description": "更深一档（footer/暗部）" },
    "panel": { "value": "#ffffff", "description": "浅色界面卡片/面板底" },
    "panel-dark": { "value": "#282828", "description": "深色界面卡片/面板底" },
    "panel-2-dark": { "value": "#313131", "description": "深色界面次级面板/hover 底" },
    "ink": { "value": "#1d1d1d", "description": "主文字（浅色界面）" },
    "ink-2": { "value": "#4a4a4a", "description": "次级文字（浅色界面）" },
    "ink-3": { "value": "#8a8a8a", "description": "弱化文字/占位（浅色界面）" },
    "text-2-dark": { "value": "#afafaf", "description": "深色界面次级文字（style-guide）" },
    "text-3-dark": { "value": "#7d7d7d", "description": "深色界面弱化文字（style-guide）" },
    "text-muted-dark": { "value": "#616161", "description": "深色界面占位/禁用（style-guide）" },
    "line": { "value": "rgba(29,29,29,0.12)", "description": "浅色界面细分割线" },
    "line-dark": { "value": "rgba(255,255,255,0.08)", "description": "深色界面细分割线" },
    "accent": { "value": "#50e5fb", "description": "唯一品牌点缀色：聚焦/选中/主 CTA/关键高亮（style-guide 主强调）" },
    "accent-2": { "value": "#7ce3f2", "description": "次级强调（文字高亮，style-guide）" },
    "accent-ink": { "value": "#0b7d92", "description": "点缀色文字版（浅底上保证对比度 ≥4.5:1）" },
    "accent-dim": { "value": "rgba(80,229,251,0.16)", "description": "强调色蒙层/标签底" },
    "pink": { "value": "#fe5a95", "description": "点缀（徽章/彩蛋，style-guide）" },
    "purple": { "value": "#7958cb", "description": "点缀（次要品牌，style-guide）" },
    "success": { "value": "#1a7f37", "description": "成功状态（浅底）/ 深底用 #3fb950" },
    "warning": { "value": "#9a6700", "description": "警告（浅底）/ 深底用 #d29922" },
    "danger": { "value": "#cf222e", "description": "错误/危险（浅底）/ 深底用 #f85149" }
  },
  "typography": {
    "font-sans": { "value": "\"PingFang SC\", \"Microsoft YaHei\", \"Noto Sans SC\", system-ui, sans-serif", "description": "正文/标题默认栈" },
    "font-serif": { "value": "\"Songti SC\", \"Noto Serif SC\", \"Source Han Serif SC\", Georgia, serif", "description": "展示型标题（品牌级，衬线杂志感）" },
    "font-mono": { "value": "ui-monospace, \"JetBrains Mono\", Consolas, monospace", "description": "工程元素（代码/路径/ID/时间戳）" },
    "fs-display": { "value": "56px", "weight": 600, "description": "全屏主标题（品牌级，一次一页一个）" },
    "fs-title": { "value": "30px", "weight": 600, "description": "板块标题" },
    "fs-subtitle": { "value": "19px", "weight": 500, "description": "副标题/导航入口" },
    "fs-body": { "value": "16px", "weight": 400, "description": "正文（长文/表单 ≥16px 防 iOS 缩放）" },
    "fs-caption": { "value": "13px", "weight": 400, "description": "时间戳/辅助文字/注释" }
  },
  "spacing": {
    "space-1": { "value": "4px", "description": "基准单位（一切间距取 4 的倍数）" },
    "space-2": { "value": "8px", "description": "元素内部" },
    "space-3": { "value": "12px", "description": "紧凑元素间" },
    "space-4": { "value": "16px", "description": "同组元素间/卡片标准内边距" },
    "space-5": { "value": "24px", "description": "相邻组件间" },
    "space-6": { "value": "32px", "description": "较大分组" },
    "space-7": { "value": "48px", "description": "区块之间（≥48px）" },
    "space-8": { "value": "64px", "description": "大区块/全屏页内容区" }
  },
  "radius": {
    "radius-sm": { "value": "4px", "description": "标签/小按钮" },
    "radius-md": { "value": "8px", "description": "卡片/输入框" },
    "radius-lg": { "value": "16px", "description": "大卡片/弹窗" },
    "radius-full": { "value": "999px", "description": "徽章/胶囊 Tab" }
  },
  "shadows": {
    "shadow-none": { "value": "none", "description": "默认：卡片靠描边+间距区分，不靠阴影（克制原则）" },
    "shadow-sm": { "value": "0 1px 2px rgba(29,29,29,0.06)", "description": "悬浮轻反馈" },
    "shadow-md": { "value": "0 2px 12px rgba(29,29,29,0.10)", "description": "弹窗/下拉" },
    "shadow-accent": { "value": "0 2px 12px rgba(80,229,251,0.18)", "description": "强调色光晕（仅 hover/聚焦等品牌时刻）" }
  }
}
